#!/usr/bin/python3
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import stat
import sys
from typing import Sequence

SCHEMA_VERSION = 1
PROBE_VERSION = 1
INSTALLED_PATH = Path("/usr/local/libexec/pia-bazzite/pia-bazzite-auth-probe")
EXIT_VALIDATION = 2
EXIT_PRIVILEGE = 3
EXIT_INSTALLATION = 4


class ValidationError(ValueError):
    pass


class InstallationError(RuntimeError):
    pass


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="pia-bazzite-auth-probe",
        description=(
            "Network-free stage-2 probe for verifying the root-owned installation "
            "and pkexec authorization boundary."
        ),
    )
    parser.add_argument("--version", action="version", version=f"stage-2 probe {PROBE_VERSION}")
    subparsers = parser.add_subparsers(dest="action", required=True)
    subparsers.add_parser("status", help="Verify pkexec, ownership, and the fixed install path.")
    return parser


def _emit(payload: dict[str, object], *, stream: object = sys.stdout) -> None:
    print(json.dumps(payload, sort_keys=True), file=stream)


def _error(kind: str, message: str, code: int) -> int:
    _emit(
        {
            "ok": False,
            "schema_version": SCHEMA_VERSION,
            "probe_version": PROBE_VERSION,
            "error": kind,
            "message": message,
        },
        stream=sys.stderr,
    )
    return code


def _require_root() -> None:
    if os.geteuid() != 0:
        raise PermissionError("The installed stage-2 probe must run as root through pkexec.")


def _invoking_uid() -> int:
    raw = os.environ.get("PKEXEC_UID", "")
    if not raw.isascii() or not raw.isdecimal():
        raise PermissionError("PKEXEC_UID is missing or invalid; invocation through pkexec was not verified.")
    uid = int(raw, 10)
    if uid <= 0:
        raise PermissionError("The pkexec caller must be an unprivileged local user.")
    return uid


def _mode_is_safe(metadata: os.stat_result) -> bool:
    return (stat.S_IMODE(metadata.st_mode) & 0o022) == 0


def _verify_directory(path: Path) -> None:
    try:
        metadata = path.stat()
    except OSError as exc:
        raise InstallationError(f"Could not inspect installation directory {path}: {exc}") from exc
    if not stat.S_ISDIR(metadata.st_mode):
        raise InstallationError(f"Installation component is not a directory: {path}")
    if metadata.st_uid != 0 or metadata.st_gid != 0:
        raise InstallationError(f"Installation directory is not owned by root:root: {path}")
    if not _mode_is_safe(metadata):
        raise InstallationError(f"Installation directory is group- or world-writable: {path}")


def _verify_installation() -> str:
    try:
        actual = Path(__file__).resolve(strict=True)
        expected = INSTALLED_PATH.resolve(strict=True)
    except OSError as exc:
        raise InstallationError(f"Could not resolve the fixed installation path: {exc}") from exc

    if actual != expected:
        raise InstallationError(
            f"Refusing to run outside the fixed root-owned path {INSTALLED_PATH}."
        )

    try:
        metadata = actual.stat()
    except OSError as exc:
        raise InstallationError(f"Could not inspect the installed probe: {exc}") from exc

    if not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1:
        raise InstallationError("The installed probe is not a single regular file.")
    if metadata.st_uid != 0 or metadata.st_gid != 0:
        raise InstallationError("The installed probe is not owned by root:root.")
    if not _mode_is_safe(metadata):
        raise InstallationError("The installed probe is group- or world-writable.")

    # Verify only the root-owned persistent installation directories. /usr/local
    # itself is a distribution-managed symlink on Bazzite and resolves into /var.
    _verify_directory(actual.parent)
    _verify_directory(actual.parent.parent)
    return str(actual)


def main(argv: Sequence[str] | None = None) -> int:
    try:
        args = _parser().parse_args(argv)
        if args.action != "status":  # pragma: no cover - argparse prevents this branch.
            raise ValidationError(f"Unsupported action: {args.action}")

        _require_root()
        invoking_uid = _invoking_uid()
        installed_path = _verify_installation()

        _emit(
            {
                "ok": True,
                "schema_version": SCHEMA_VERSION,
                "probe_version": PROBE_VERSION,
                "action": "status",
                "euid": os.geteuid(),
                "invoking_uid": invoking_uid,
                "installed_path": installed_path,
                "ownership_verified": True,
                "pkexec_verified": True,
                "network_access": False,
                "nftables_access": False,
            }
        )
        return 0
    except ValidationError as exc:
        return _error("validation", str(exc), EXIT_VALIDATION)
    except PermissionError as exc:
        return _error("privilege", str(exc), EXIT_PRIVILEGE)
    except InstallationError as exc:
        return _error("installation", str(exc), EXIT_INSTALLATION)
    except OSError as exc:
        return _error("operating-system", str(exc), EXIT_INSTALLATION)


if __name__ == "__main__":
    raise SystemExit(main())
